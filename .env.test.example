# =============================================================================
# Test Environment Configuration
# =============================================================================
# Copy this file to .env.test and fill in your own values.
# .env.test is git-ignored — your changes won't be tracked.
#
# Priority (highest wins): process.env > .env.test > code defaults
# =============================================================================

# --- LLM Provider (required for message-send / ready-state e2e tests) -------

# Base URL of your OpenAI-compatible provider endpoint
AO_TEST_PROVIDER_BASE_URL=http://192.168.0.18:25555/v1

# API key for your provider
AO_TEST_PROVIDER_API_KEY=e2e-test-key

# Comma-separated list of model names (must be available on your provider)
AO_TEST_PROVIDER_MODELS=gemma-4-e4b-uncensored-hauhaucs-aggressive,qwen3.5-9b-uncensored-hauhaucs-aggressive

# --- Docker (optional — override if using a different image) ----------------

# AO_TEST_DOCKER_IMAGE=ghcr.io/anomalyco/opencode
# AO_TEST_CONTAINER_PORT=3000
