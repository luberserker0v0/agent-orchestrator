# =============================================================================
# Test Environment Configuration
# =============================================================================
# Copy this file to .env.test and fill in your own values.
# .env.test is git-ignored — your changes won't be tracked.
#
# Priority (highest wins): process.env > .env.test > defaults
# AO_TEST_PROVIDER_BASE_URL and AO_TEST_PROVIDER_MODELS are required.
# =============================================================================

# --- LLM Provider (required for message-send / ready-state e2e tests) -------

# Base URL of your OpenAI-compatible provider endpoint (required)
AO_TEST_PROVIDER_BASE_URL=http://localhost:25555/v1

# API key for your provider (optional, defaults to 'e2e-test-key')
AO_TEST_PROVIDER_API_KEY=e2e-test-key

# Comma-separated list of model names available on your provider (required)
AO_TEST_PROVIDER_MODELS=CHANGEME

# --- Server overrides (optional) --------------------------------------------

# AO_TEST_SERVER_HOST=127.0.0.1
# AO_TEST_SHUTDOWN_TIMEOUT_MS=15000
# AO_TEST_HEARTBEAT_INTERVAL_MS=30000
# AO_TEST_IDLE_TIMEOUT_MS=600000

# --- Docker (optional — override if using a different image) ----------------

# AO_TEST_DOCKER_IMAGE=ghcr.io/anomalyco/opencode
# AO_TEST_CONTAINER_PORT=3000
