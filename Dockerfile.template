FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Install opencode binary (version from build arg)
ARG OPENCODE_VERSION
RUN if [ -n "$OPENCODE_VERSION" ]; then \
      echo "Downloading opencode v$OPENCODE_VERSION..." && \
      wget -qO /tmp/opencode.tar.gz "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-x64-musl.tar.gz" && \
      tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin && \
      chmod +x /usr/local/bin/opencode && \
      rm /tmp/opencode.tar.gz; \
    fi

FROM node:20-alpine AS production
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Install opencode binary in final stage if version provided
ARG OPENCODE_VERSION
RUN if [ -n "$OPENCODE_VERSION" ]; then \
      echo "Installing opencode v$OPENCODE_VERSION..." && \
      apk add --no-cache wget && \
      wget -qO /tmp/opencode.tar.gz "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-x64-musl.tar.gz" && \
      tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin && \
      chmod +x /usr/local/bin/opencode && \
      rm /tmp/opencode.tar.gz && \
      apk del wget; \
    fi

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/bin ./bin
COPY --from=builder /app/config ./config

RUN mkdir -p /data/workspace && chown -R nodejs:nodejs /data/workspace
ENV AGENTORCHESTRATOR_WORKSPACE_BASEPATH=/data/workspace

USER nodejs
EXPOSE 8080
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
CMD ["node", "dist/index.js", "--port", "8080", "--host", "0.0.0.0"]
