{
  "name": "agent-orchestrator",
  "version": "1.0.0",
  "description": "Node.js orchestrator that spawns isolated OpenCode instances per conversation over HTTP and WebSocket",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "node scripts/clean.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config e2e/vitest.config.e2e.ts",
    "preflight": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "opencode",
    "websocket",
    "llm",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cross-spawn": "^7.0.3",
    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "jsonc-parser": "^3.3.1",
    "prom-client": "^15.1.3",
    "tree-kill": "^1.2.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
