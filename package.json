{
  "name": "@luberserker/agent-orchestrator",
  "version": "1.2.1",
  "description": "Node.js orchestrator that spawns isolated OpenCode instances per conversation over HTTP and WebSocket",
  "main": "dist/index.js",
  "bin": {
    "aor": "bin/aor.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "config/agentorchestrator.example.json",
    "config/canonical-opencode.example.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "verify:package": "node scripts/verify-package.cjs",
    "clean": "node scripts/clean.js",
    "lint": "eslint src/ \"e2e/**/*.ts\"",
    "lint:fix": "eslint src/ \"e2e/**/*.ts\" --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e:docker": "cross-env E2E_RUNTIME=docker vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:direct": "vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:runtime": "cross-env E2E_RUNTIME=docker vitest run --config e2e/vitest.config.runtime.ts",
    "test:e2e:kubernetes": "vitest run --config e2e/vitest.config.kubernetes.ts",
    "test:e2e:k3d": "tsx e2e/kubernetes/run-k3d.ts",
    "test:e2e": "npm run test:e2e:docker",
    "test:e2e:watch": "cross-env E2E_RUNTIME=docker vitest --config e2e/vitest.config.e2e.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "preflight": "npm run verify:package && npm run lint && npm run test && npm run build && npm run typecheck:e2e"
  },
  "keywords": [
    "opencode",
    "websocket",
    "llm",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "adm-zip": "^0.6.1",
    "cross-spawn": "^7.0.3",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
