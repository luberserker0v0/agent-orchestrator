{
  "name": "agent-orchestrator",
  "version": "1.0.0",
  "description": "Node.js orchestrator that spawns isolated OpenCode instances per conversation over HTTP and WebSocket",
  "main": "dist/index.js",
  "bin": {
    "aor": "./bin/aor.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "config/agentorchestrator.example.json",
    "config/canonical-opencode.example.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "clean": "node scripts/clean.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e:docker": "cross-env E2E_RUNTIME=docker vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:direct": "vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:runtime": "cross-env E2E_RUNTIME=docker vitest run --config e2e/vitest.config.runtime.ts",
    "test:e2e": "npm run test:e2e:docker",
    "test:e2e:watch": "cross-env E2E_RUNTIME=docker vitest --config e2e/vitest.config.e2e.ts",
    "preflight": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "opencode",
    "websocket",
    "llm",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cross-spawn": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
