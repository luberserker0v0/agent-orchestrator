{
  "server": {
    "port": 0,
    "host": "127.0.0.1"
  },
  "websocket": {
    "heartbeatIntervalMs": 30000,
    "idleTimeoutMs": 600000
  },
  "orchestrator": {
    "maxInstances": 10,
    "portRange": {
      "start": 30000,
      "end": 30100
    },
    "opencodeBinary": "opencode",
    "healthCheck": {
      "retries": 10,
      "intervalMs": 500
    }
  },
  "workspace": {
    "basePath": "./workspace",
    "defaultPermissions": {
      "external_directory": {
        "*": "deny"
      },
      "bash": {
        "*": "deny"
      }
    }
  }
}
