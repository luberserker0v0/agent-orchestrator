{
  // ── HTTP Server ───────────────────────────────────────────────────
  "server": {
    "port": 0,                 // 0 = auto-assign; set to e.g. 8080 for a fixed port
    "host": "127.0.0.1",      // Bind address (use "0.0.0.0" for all interfaces)
    "shutdownTimeoutMs": 15000, // Max ms to wait for graceful shutdown before force exit
    "apiKey": "",               // Optional (deprecated): single Bearer token. Use apiKeys instead.
    "apiKeys": [                // Optional: role-based API keys. Takes precedence over apiKey.
      { "key": "admin-secret-123456", "role": "admin", "name": "Admin" },
      { "key": "user-secret-123456", "role": "user", "name": "User" },
      { "key": "observer-secret-123456", "role": "observer", "name": "Observer" }
    ],
    "rbac": {
      "enabled": true           // true = enforce auth (startup fails if no keys); false = disable auth; omit = backward-compatible
    }
  },

  // ── Role Definitions (RBAC) ──────────────────────────────────────
  // Permissions: "resource:action" format, "*" for admin wildcard
  // Built-in roles (admin, user, observer) are immutable and need not be listed.
  // Custom roles are persisted to this section when modified via POST /api/roles
  // and may be assigned to entries in server.apiKeys.
  "roles": {
    "auditor": {
      "permissions": ["conversation:list", "conversation:get", "conversation:events"]
    }
  },

  // ── WebSocket ─────────────────────────────────────────────────────
  "websocket": {
    "heartbeatIntervalMs": 30000, // Ping interval (ms); 0 = disabled
    "idleTimeoutMs": 600000       // Connection idle timeout (ms); 0 = no timeout
  },

  // ── Logging and Cleanup ──────────────────────────────────────────
  "logging": {
    "file": {
      "enabled": false,            // Console logging always remains enabled
      "directory": "./logs",       // Rotating JSONL files; use a persistent mount in containers
      "maxFileSizeBytes": 10485760,
      "maxRotatedFiles": 10,       // Active agentorchestrator.jsonl is not counted
      "retentionMs": 604800000     // Seven days
    }
  },
  "cleanup": {
    "ownerId": null,               // Required when orphanedData.enabled=true; keep stable across restarts
    "sweepIntervalMs": 3600000,
    "orphanedData": {
      "enabled": false,            // Explicit conversation DELETE still removes managed data immediately
      "gracePeriodMs": 2592000000  // 30 days from first observed orphan state
    }
  },

  // ── Orchestrator (OpenCode instance lifecycle) ────────────────────
  "orchestrator": {
    "maxInstances": 10,           // Strict upper limit of concurrent OpenCode instances
    "idleTimeoutMs": 600000,      // Auto-destroy after inactivity (ms); 0 = disabled
    "idleSweepIntervalMs": 60000, // Idle check interval (ms)
    "portRange": {
      "start": 30000,
      "end": 30100,              // maxInstances must not exceed portRange.end - portRange.start + 1 (unless allowDynamicFallback is true)
      "allowDynamicFallback": true  // When port range exhausted, use OS-assigned port
    },

    // Default agent type — must match one of the runtime entry ids below
    "defaultAgentType": "opencode-direct",

    // Runtime entries — each defines how OpenCode instances are spawned for a given agent type
    // "direct" = spawn opencode binary directly on the host
    // "docker" = spawn opencode inside a Docker container
    "runtimes": [
      {
        "id": "opencode-direct",
        "type": "direct",
        "config": {
          "binary": "opencode",
          "version": "1.17.8"
          // "instanceHost": "127.0.0.1"  // Hostname to reach spawned instances (default: "127.0.0.1")
          // Per-conversation opencode data-dir (session persistence across restarts/migration).
          // Omit for opencode defaults (ephemeral sessions). One subdirectory per conversation
          // id is created automatically; mount the same root at an identical absolute path on
          // every machine to resume sessions cross-host.
          // "sessionStorage": {
          //   "sharedRoot": "./sessions",  // Relative paths resolve against the orchestrator cwd
          //   "mode": "xdg"                // "xdg" = XDG_DATA_HOME=<root>/<id>; "sqlite" adds OPENCODE_DB=<root>/<id>/opencode.db
          // }
        }
      },
      {
        "id": "opencode-docker",
        "type": "docker",
        "config": {
          "image": "ghcr.io/anomalyco/opencode:1.17.8"
          // "instanceHost": "127.0.0.1"  // Hostname to reach spawned instances (default: "127.0.0.1")
          // "networkMode": "bridge"       // Docker network mode: "host", "bridge", or custom network name
          // To enable either optional property below, add a comma after "image" and
          // between enabled properties.
          // "logging": { "driver": "local", "maxSize": "10m", "maxFiles": 3 }
          // Same sessionStorage semantics as direct; mounted as /opencode-data in the container.
          // "sessionStorage": { "sharedRoot": "./sessions", "mode": "xdg" }
        }
      }  // NOTE: no trailing comma — uncomment the block below to add a kubernetes runtime (add the comma back first)
      // Kubernetes runtime: spawn one Pod + ClusterIP Service per instance.
      // Requires the per-conversation PVC (conv-<id>) to exist; mount paths match
      // the volume layout in k8s/volume/. Uncomment to enable.
      // {
      //   "id": "opencode-k8s",
      //   "type": "kubernetes",
      //   "config": {
      //     "image": "ghcr.io/anomalyco/opencode:1.17.8",
      //     "namespace": "ao-instances",
      //     "sessionMode": "xdg",
      //     "pvcStorage": "10Gi"
      //     // "instanceHost": "127.0.0.1",  // + kubectl port-forward when orchestrating from outside
      //     // "nodeName": "worker-2",        // Pin scheduling (migration target)
      //     // "podReadyTimeoutMs": 180000
      //   }
      // }
    ],

    // Health check — how long to wait for an OpenCode instance to become ready
    "healthCheck": {
      "retries": 10,         // Number of health check attempts before giving up
      "intervalMs": 500,     // Delay between retries (ms)
      "clientTimeoutMs": 5000 // HTTP client timeout per health check request (ms)
    },

    // SSE — event forwarding from OpenCode instances to WebSocket clients
    "sse": {
      "enabled": true,              // Enable SSE event forwarding
      "reconnectMaxAttempts": 10,   // Max reconnect attempts before giving up
      "reconnectBaseMs": 1000,      // Base delay in ms for exponential backoff
      "filterHeartbeat": true       // Filter heartbeat events to reduce noise
    }
  },

  // ── Workspace ─────────────────────────────────────────────────────
  "workspace": {
    "basePath": "./workspace",
    // When true: user-submitted opencode.json is merged with canonical-opencode.json,
    // and canonical keys always win (security enforcement).
    // When false: user-submitted opencode.json is written verbatim.
    "enforceCanonicalConfig": true,
    // Maximum size of a workspace directory in bytes (default: 50 MB)
    "maxSizeBytes": 52428800,
    // Storage backend configuration
    "storage": {
      "type": "local"  // Currently only "local" is supported
    }
  }

  // ── Cluster (Kubernetes status reporting) ───────────────────────────
  // Reports OpencodeInstance lifecycle/quota status to the cluster so a
  // placement controller can migrate conversations off exhausted machines.
  // Disabled by default; omit or set enabled=false for single-node use.
  // "cluster": {
  //   "enabled": true,                // Report to OpencodeInstance CRs (requires CRDs installed)
  //   "namespace": "ao-instances",    // Namespace for OpencodeInstance objects
  //   "heartbeatIntervalMs": 60000,   // Status heartbeat interval (0 = disable)
  //   "quotaFailureThreshold": 2,     // Consecutive quota errors before QuotaExhausted
  //   "advertiseBaseUrl": "http://orchestrator.ao-instances.svc.cluster.local:8080"  // Owner URL for operator-triggered migration (defaults to server host:port)
  // }
}
