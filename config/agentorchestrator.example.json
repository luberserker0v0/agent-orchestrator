{
  // ── HTTP Server ───────────────────────────────────────────────────
  "server": {
    "port": 0,                 // 0 = auto-assign; set to e.g. 8080 for a fixed port
    "host": "127.0.0.1",      // Bind address (use "0.0.0.0" for all interfaces)
    "shutdownTimeoutMs": 15000, // Max ms to wait for graceful shutdown before force exit
    "apiKey": "",               // Optional (deprecated): single Bearer token. Use apiKeys instead.
    "apiKeys": [                // Optional: role-based API keys. Takes precedence over apiKey.
      { "key": "admin-secret-123456", "role": "admin", "name": "Admin" },
      { "key": "observer-secret-123456", "role": "observer", "name": "Observer" }
    ],

    // ── Role Definitions (RBAC) ──────────────────────────────────────
    // Permissions: "resource:action" format, "*" for admin wildcard
    // Built-in resources: conversation, message, config, agent, file, session, skill, role
    // Roles are persisted to config file when modified via POST /api/roles
    "roles": {
      "admin": {
        "permissions": ["*"]       // Full access + role management
      },
      "user": {
        "permissions": [           // Conversation services (CRUD + messages)
          "conversation:create", "conversation:start", "conversation:stop",
          "conversation:restart", "conversation:read", "conversation:list",
          "message:send", "message:read",
          "config:read", "config:write",
          "agent:read", "file:read", "file:write", "file:delete",
          "session:read", "session:create", "session:delete",
          "skill:read", "skill:import", "skill:delete"
        ]
      },
      "observer": {
        "permissions": [           // Read-only access
          "conversation:read", "conversation:list",
          "message:read",
          "config:read",
          "agent:read",
          "session:read",
          "skill:read"
        ]
      }
    }
  },

  // ── WebSocket ─────────────────────────────────────────────────────
  "websocket": {
    "heartbeatIntervalMs": 30000, // Ping interval (ms); 0 = disabled
    "idleTimeoutMs": 600000       // Connection idle timeout (ms); 0 = no timeout
  },

  // ── Orchestrator (OpenCode instance lifecycle) ────────────────────
  "orchestrator": {
    "maxInstances": 10,           // Strict upper limit of concurrent OpenCode instances
    "idleTimeoutMs": 600000,      // Auto-destroy after inactivity (ms); 0 = disabled
    "idleSweepIntervalMs": 60000, // Idle check interval (ms)
    "portRange": {
      "start": 30000,
      "end": 30100,              // maxInstances must not exceed portRange.end - portRange.start + 1 (unless allowDynamicFallback is true)
      "allowDynamicFallback": true  // When port range exhausted, use OS-assigned port
    },

    // Default agent type — must match one of the runtime entry ids below
    "defaultAgentType": "opencode-direct",

    // Runtime entries — each defines how OpenCode instances are spawned for a given agent type
    // "direct" = spawn opencode binary directly on the host
    // "docker" = spawn opencode inside a Docker container
    "runtimes": [
      {
        "id": "opencode-direct",
        "type": "direct",
        "config": {
          "binary": "opencode",
          "version": "1.17.8"
          // "instanceHost": "127.0.0.1"  // Hostname to reach spawned instances (default: "127.0.0.1")
        }
      },
      {
        "id": "opencode-docker",
        "type": "docker",
        "config": {
          "image": "ghcr.io/anomalyco/opencode:1.17.8"
          // "instanceHost": "127.0.0.1"  // Hostname to reach spawned instances (default: "127.0.0.1")
          // "networkMode": "bridge"       // Docker network mode: "host", "bridge", or custom network name
        }
      }
    ],

    // Health check — how long to wait for an OpenCode instance to become ready
    "healthCheck": {
      "retries": 10,         // Number of health check attempts before giving up
      "intervalMs": 500,     // Delay between retries (ms)
      "clientTimeoutMs": 5000 // HTTP client timeout per health check request (ms)
    }
  },

  // ── Workspace ─────────────────────────────────────────────────────
  "workspace": {
    "basePath": "./workspace",
    // When true: user-submitted opencode.json is merged with canonical-opencode.json,
    // and canonical keys always win (security enforcement).
    // When false: user-submitted opencode.json is written verbatim.
    "enforceCanonicalConfig": true,
    // Maximum size of a workspace directory in bytes (default: 50 MB)
    "maxSizeBytes": 52428800
  }
}
